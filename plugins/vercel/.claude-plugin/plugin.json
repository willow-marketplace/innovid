{
  "name": "vercel",
  "version": "1.0.0",
  "description": "Build and deploy web apps and AI agents on Vercel with skills for Next.js, AI SDK, and cloud services, plus the official Vercel MCP server.",
  "updatedAt": "2026-11-26T00:04:04.679Z",
  "author": {
    "url": "https://vercel.com",
    "name": "Vercel"
  },
  "homepage": "https://github.com/vercel/vercel-plugin#readme",
  "repository": "https://github.com/vercel/vercel-plugin",
  "keywords": [
    "vercel",
    "nextjs",
    "ai-sdk",
    "deployment",
    "serverless",
    "mcp"
  ],
  "displayName": "Vercel",
  "logo": "assets/vercel-antigravity.svg",
  "skills": "./skills/",
  "commands": "./commands/",
  "agents": [
    "./agents/ai-architect.md",
    "./agents/deployment-expert.md",
    "./agents/performance-optimizer.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-profiler.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-seen-skills.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-claude-md.mjs\" --part 2/2"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-claude-md.mjs\" --part 1/2"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end-cleanup.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse-skill-telemetry.mjs\""
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "vercel": {
      "url": "https://mcp.vercel.com",
      "note": "Official Vercel MCP server. Uses OAuth to authorize access to your teams. Supports reads and writes, including documentation search, project and deployment inspection, logs, deployments, and resource updates. Available tools depend on the connection; your team grants and Vercel permissions apply. Domain registration requires a quote and explicit approval. Digital subscriptions, credits, and add-on purchases are unavailable through MCP.",
      "type": "http"
    }
  }
}