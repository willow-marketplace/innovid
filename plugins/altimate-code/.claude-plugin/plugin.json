{
  "name": "altimate-code",
  "version": "1.8.3",
  "description": "Gives Claude Code altimate-code's model-free data tools (column-level lineage, impact analysis, PII detection, data-diff, FinOps, query equivalence, dialect translation, warehouse queries) through its MCP server, or through `altimate tool run` when MCP servers are not allowed, with delegation to the altimate-code agent for long dbt jobs, access to a linked Altimate workspace's knowledge, and the workspace's team rules in each session.",
  "updatedAt": "2026-11-20T12:01:19.212Z",
  "author": {
    "url": "https://altimate.ai",
    "name": "AltimateAI"
  },
  "homepage": "https://github.com/AltimateAI/altimate-claude-plugin",
  "repository": "https://github.com/AltimateAI/altimate-claude-plugin",
  "keywords": [
    "dbt",
    "sql",
    "data-engineering",
    "warehouse",
    "snowflake",
    "bigquery",
    "databricks",
    "column-lineage"
  ],
  "displayName": "Altimate Code",
  "skills": "./skills/",
  "commands": "./commands/",
  "agents": [
    "./agents/analyst.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/warehouse-guard.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/refresh-skills.sh\" --if-stale"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/workspace-rules.sh\" stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/workspace-rules.sh\" session-start"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/workspace-rules.sh\" user-prompt-submit"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "altimate-code": {
      "args": [
        "mcp",
        "serve",
        "--workspace-tools"
      ],
      "command": "altimate-code"
    }
  }
}