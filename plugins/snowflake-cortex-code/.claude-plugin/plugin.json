{
  "name": "snowflake-cortex-code",
  "version": "3.7.1",
  "description": "Route Snowflake prompts from Claude Code to the local Cortex Code CLI or an opt-in managed MCP Coding Agent.",
  "updatedAt": "2026-11-26T00:03:17.095Z",
  "author": {
    "name": "Snowflake"
  },
  "homepage": "https://docs.snowflake.com/en/user-guide/cortex-code/cortex-code",
  "repository": "https://github.com/Snowflake-Labs/snowflake-ai-kit",
  "keywords": [
    "snowflake",
    "cortex-code",
    "auto-routing",
    "sql",
    "data"
  ],
  "skills": "./skills/",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/router/discover_cortex.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/router/prompt_filter.py\""
          }
        ]
      }
    ]
  }
}