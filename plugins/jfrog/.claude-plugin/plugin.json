{
  "name": "jfrog",
  "version": "1.0.0",
  "description": "Official JFrog plugin. Connect Claude Code to JFrog to manage, secure, and govern your software supply chain. Give agents the context to build secure, compliant software.",
  "updatedAt": "2026-11-20T12:02:30.165Z",
  "author": {
    "url": "https://jfrog.com",
    "name": "JFrog Ltd.",
    "email": "devrel@jfrog.com"
  },
  "homepage": "https://jfrog.com",
  "repository": "https://github.com/jfrog/claude-plugin",
  "keywords": [
    "jfrog",
    "artifactory",
    "xray",
    "security",
    "devops",
    "supply-chain",
    "artifacts",
    "curation",
    "agent-guard",
    "package-resolution",
    "ai-catalog"
  ],
  "displayName": "JFrog",
  "skills": "./skills/",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/modules/claude-session-start.mjs\" package-resolution"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/modules/core/local-shadow-trigger.mjs\" session_start"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/claude-register-align-watch-paths.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/claude-align-mcp-json.mjs\" session-start"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/claude-prewarm-agent-guard.mjs\""
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "(installed_plugins|known_marketplaces)\\.json$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/claude-align-mcp-json.mjs\" file-changed"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/modules/core/enforce-skill.mjs\" --client claude-code --prefer-offline"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/modules/core/enforce-skill.mjs\" --client claude-code --prefer-offline"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "jfrog": {
      "url": "${JFROG_URL}/mcp",
      "type": "http"
    }
  }
}