{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Read|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3"
          }
        ]
      }
    ]
  }
}