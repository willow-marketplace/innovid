{
  "name": "posthog",
  "version": "1.0.0",
  "description": "Access PostHog analytics, feature flags, experiments, error tracking, and insights directly from Antigravity",
  "updatedAt": "2026-11-20T00:04:18.848Z",
  "author": {
    "url": "https://posthog.com",
    "name": "PostHog",
    "email": "hey@posthog.com"
  },
  "homepage": "https://posthog.com/docs/model-context-protocol",
  "repository": "https://github.com/PostHog/ai-plugin",
  "keywords": [
    "analytics",
    "feature-flags",
    "experiments",
    "error-tracking",
    "a/b-testing",
    "surveys",
    "dashboards",
    "llm-analytics"
  ],
  "logo": "assets/posthog-logomark-square.svg",
  "skills": "./skills/",
  "commands": "./commands/",
  "agents": [
    "./agents/error-analyzer.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "__exec$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/gate-exec-write.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/telemetry/hooks/session-end-llma.py\""
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "posthog": {
      "url": "https://mcp.posthog.com/mcp",
      "type": "http",
      "headers": {
        "x-posthog-mcp-consumer": "plugin"
      },
      "headersHelper": "cat claude-code-headers.json || type claude-code-headers.json"
    }
  }
}