  "description": "[DEPRECATED] AWS Dev Toolkit is no longer maintained. Startup-specific guidance is available in AWS Startup Advisor; install aws-startup-advisor@claude-plugins-official. For general-purpose AWS guidance, use Agent Toolkit for AWS (aws configure agent-toolkit). This AWS Dev Toolkit plugin will stop receiving updates and will be removed from the marketplace. Existing installs continue to function during the transition; install AWS Startup Advisor to keep receiving startup guidance.",
  "updatedAt": "2026-08-19T00:32:18.028Z",
  "author": {
    "name": "aws-samples"
  },
  "homepage": "https://github.com/aws-samples/sample-claude-code-plugins-for-startups/tree/main/plugins/aws-dev-toolkit",
  "repository": "https://github.com/aws-samples/sample-claude-code-plugins-for-startups",
  "keywords": [
    "aws",
    "cdk",
    "cloudformation",
    "terraform",
    "serverless",
    "well-architected",
    "iac",
    "migration",
    "gcp",
    "azure",
    "bedrock"
  ],
  "skills": "./skills/",
  "agents": [
    "./agents/agentcore-sme.md",
    "./agents/aws-explorer.md",
    "./agents/bedrock-sme.md",
    "./agents/container-sme.md",
    "./agents/cost-optimizer.md",
    "./agents/iac-reviewer.md",
    "./agents/migration-advisor.md",
    "./agents/networking-sme.md",
    "./agents/observability-sme.md",
    "./agents/serverless-sme.md",
    "./agents/well-architected-reviewer.md"
  ],
  "mcpServers": {
    "awsiac": {
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "args": [
        "awslabs.aws-iac-mcp-server@latest"
      ],
      "type": "stdio",
      "command": "uvx"
    },
    "awspricing": {
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "type": "stdio",
      "command": "uvx",
      "timeout": 120000
    },
    "awsknowledge": {
      "url": "https://knowledge-mcp.global.api.aws",
      "type": "http"
    }
  }
