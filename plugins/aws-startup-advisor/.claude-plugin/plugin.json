  "skills": "./skills/",
  "agents": [
    "./agents/generic-phase-worker-rw.md",
    "./agents/llm2bedrock-code-analyzer.md",
    "./agents/llm2bedrock-code-rewriter.md",
    "./agents/llm2bedrock-log-ingestor.md",
    "./agents/llm2bedrock-prompt-evaluator.md",
    "./agents/llm2bedrock-report-generator.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat ${CLAUDE_PLUGIN_ROOT}/scripts/startup-context.txt"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "awspricing": {
      "env": {
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "type": "stdio",
      "command": "uvx",
      "timeout": 120000,
      "autoApprove": [
        "get_pricing_service_codes",
        "get_pricing_service_attributes",
        "get_pricing_attribute_values",
        "get_pricing"
      ]
    },
    "awsknowledge": {
      "url": "https://knowledge-mcp.global.api.aws",
      "type": "http"
    },
    "temporal-docs": {
      "url": "https://temporal.mcp.kapa.ai",
      "type": "http"
    },
    "aws-pricing-calculator": {
      "args": [
        "-y",
        "sample-aws-pricing-calculator-mcp@1.2.8"
      ],
      "type": "stdio",
      "command": "npx",
      "timeout": 120000,
      "autoApprove": [
        "get_server_info",
        "search_services",
        "get_service_fields",
        "create_estimate",
        "add_service",
        "validate_estimate",
        "build_estimate",
        "export_estimate"
      ]
    }
  }
}