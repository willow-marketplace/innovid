{
  "name": "datadog",
  "version": "0.7.17",
  "description": "Use Datadog directly in Claude Code through a preconfigured Datadog MCP server. Query logs, metrics, traces, dashboards, and more through natural conversation. This plugin is in preview.",
  "updatedAt": "2026-08-22T00:19:42.387Z",
  "author": {
    "name": "Datadog"
  },
  "repository": "https://github.com/datadog-labs/claude-code-plugin.git",
  "keywords": [
    "datadog",
    "infrastructure",
    "mcp",
    "observability",
    "productivity"
  ],
  "skills": "./skills/",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_datadog_mcp__(get_widget|visualize_tabular_data)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash"
          }
        ]
      }
    ]
  }
}