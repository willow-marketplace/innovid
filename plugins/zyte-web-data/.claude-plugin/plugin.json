{
  "name": "zyte-web-data",
  "version": "1.0.0",
  "description": "Zyte Agentic Web Data for Claude Code",
  "updatedAt": "2026-11-24T00:03:38.087Z",
  "author": {
    "name": "Zyte"
  },
  "homepage": "https://github.com/zytedata/claude-skills",
  "repository": "https://github.com/zytedata/claude-skills",
  "skills": "./skills/",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "zyte": {
      "url": "https://mcp.zyte.com/v1/mcp",
      "type": "http"
    }
  }
}