{
  "name": "twg-vscode",
  "displayName": "Atlassian Teamwork Graph CLI",
  "description": "Bring Jira, Confluence, Bitbucket, and connected work context into VS Code and coding agents with Atlassian Teamwork Graph CLI.",
  "version": "0.2.0",
  "publisher": "atlassian",
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://developer.atlassian.com/cloud/twg-cli/",
  "repository": {
    "type": "git",
    "url": "https://github.com/atlassian/twg-cli.git"
  },
  "bugs": {
    "url": "https://github.com/atlassian/twg-cli/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "atlassian",
    "teamwork graph",
    "twg",
    "jira",
    "confluence"
  ],
  "icon": "images/twg-logo.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWalkthrough:twg.getStarted"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "twg.setup",
        "title": "TWG: Set Up",
        "category": "Teamwork Graph"
      },
      {
        "command": "twg.refreshCliStatus",
        "title": "TWG: Refresh CLI Status",
        "category": "Teamwork Graph"
      }
    ],
    "walkthroughs": [
      {
        "id": "twg.getStarted",
        "title": "Teamwork Graph: Get Started",
        "description": "Connect your terminal and coding agents to Atlassian work context.",
        "steps": [
          {
            "id": "twg.setupMissing",
            "title": "Set up Teamwork Graph CLI",
            "description": "Teamwork Graph CLI is not set up in this environment.\n[Install Teamwork Graph CLI](command:twg.setup)\n\nFinished installing? [Check again](command:twg.refreshCliStatus)",
            "media": {
              "markdown": "walkthrough/setup.md"
            },
            "completionEvents": [
              "onContext:twg.cliAvailable"
            ],
            "when": "!twg.cliAvailable"
          },
          {
            "id": "twg.setupDetected",
            "title": "Teamwork Graph CLI detected",
            "description": "The `twg` executable is available in this environment.\n[Repair or finish setup](command:twg.setup)",
            "media": {
              "markdown": "walkthrough/setup.md"
            },
            "completionEvents": [
              "onContext:twg.cliAvailable"
            ],
            "when": "twg.cliAvailable"
          },
          {
            "id": "twg.explore",
            "title": "Bring work context into your agent",
            "description": "Use Teamwork Graph CLI to discover, understand, and act on connected work.\n[Explore Teamwork Graph CLI](https://developer.atlassian.com/cloud/twg-cli/)",
            "media": {
              "markdown": "walkthrough/use-twg.md"
            },
            "completionEvents": [
              "onLink:https://developer.atlassian.com/cloud/twg-cli/"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "vscode:prepublish": "tsc -p tsconfig.json",
    "test": "pnpm run compile && node --test dist/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  }
}
