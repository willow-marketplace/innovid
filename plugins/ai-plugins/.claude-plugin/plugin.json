{
  "name": "ai-plugins",
  "version": "1.0.0",
  "description": "Endor Labs workflow agents and setup for Claude Code.",
  "updatedAt": "2026-08-01T12:02:32.014Z",
  "author": {
    "url": "https://www.endorlabs.com/",
    "name": "Endor Labs"
  },
  "homepage": "https://github.com/endorlabs/ai-plugins",
  "repository": "https://github.com/endorlabs/ai-plugins",
  "keywords": [
    "endor-labs",
    "security",
    "sca",
    "sast",
    "claude-code",
    "agentic remediation",
    "SAST remediation",
    "agentic AppSec",
    "AppSec",
    "OSS Upgrade Investigator"
  ],
  "skills": "./skills/",
  "agents": "./agents/",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-dep-install.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-manifest-edit.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-agent-api.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/suggest-endor-tools.sh\""
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "endor-cli-tools": {
      "args": [
        "-y",
        "endorctl",
        "ai-tools",
        "mcp-server"
      ],
      "type": "stdio",
      "command": "npx"
    }
  }
}