{
  "mcpServers": {
    "cloud-storage": {
      "args": [
        "-y",
        "@toolbox-sdk/server@1.13.1",
        "--prebuilt",
        "cloud-storage",
        "--stdio",
        "--user-agent-metadata",
        "gcs-skills/1.0 (skill:gcs-skills-mcp-traffic)"
      ],
      "type": "stdio",
      "command": "npx"
    },
    "google-cloud-storage-okf": {
      "args": [
        "run",
        "--script",
        "${PLUGIN_ROOT}/skills/google-cloud-storage-okf-bucket/scripts/mcp_server.py"
      ],
      "type": "stdio",
      "command": "uv"
    }
  }
}