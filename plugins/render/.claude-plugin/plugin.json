{
  "name": "render",
  "version": "1.0.0",
  "description": "Deploy, debug, and monitor applications on Render. Includes skills, an agent, slash commands, a render.yaml validation hook, and the Render MCP server preconfigured over OAuth.",
  "updatedAt": "2026-08-13T00:02:00.306Z",
  "author": {
    "url": "https://render.com",
    "name": "Render",
    "email": "support@render.com"
  },
  "homepage": "https://github.com/render-oss/render-plugin-claude-code",
  "repository": "https://github.com/render-oss/render-plugin-claude-code",
  "keywords": [
    "render",
    "deploy",
    "cloud",
    "blueprint",
    "monitoring",
    "debugging"
  ],
  "skills": "./skills/",
  "commands": "./commands/",
  "agents": [
    "./agents/render-assistant.md"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/validate-render-yaml-hook.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "render": {
      "url": "https://mcp.render.com/mcp",
      "type": "http",
      "oauth": {
        "clientId": "claude"
      }
    }
  }
}