{
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__(?:plugin_stripe_stripe|stripe)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ]
  }
}