{
  "name": "stripe",
  "version": "1.0.0",
  "description": "Stripe development plugin for Claude",
  "updatedAt": "2026-09-18T00:04:02.423Z",
  "author": {
    "url": "https://stripe.com",
    "name": "Stripe"
  },
  "homepage": "https://docs.stripe.com",
  "repository": "https://github.com/stripe/ai",
  "keywords": [
    "stripe",
    "payments",
    "webhooks",
    "api",
    "security"
  ],
  "skills": "./skills/",
  "commands": "./commands/",
  "agents": [
    "./agents/company-researcher.md"
  ],
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__(?:plugin_stripe_stripe|stripe)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "stripe": {
      "url": "https://mcp.stripe.com",
      "type": "http"
    }
  }
}