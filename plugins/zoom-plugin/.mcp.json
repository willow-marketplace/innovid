{
  "mcpServers": {
    "zoom-mcp": {
      "url": "https://mcp.zoom.us/mcp/zoom/streamable",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${ZOOM_MCP_ACCESS_TOKEN}"
      }
    },
    "zoom-chat-mcp": {
      "url": "https://mcp.zoom.us/mcp/chat/streamable",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${ZOOM_CHAT_MCP_ACCESS_TOKEN}"
      }
    },
    "zoom-tasks-mcp": {
      "url": "https://mcp.zoom.us/mcp/tasks/streamable",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${ZOOM_TASKS_MCP_ACCESS_TOKEN}"
