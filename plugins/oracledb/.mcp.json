{
  "mcpServers": {
    "oracledb": {
      "env": {
        "ORACLE_WALLET": "${user_config.oracle_wallet}",
        "ORACLE_USE_OCI": "${user_config.oracle_use_oci}",
        "ORACLE_PASSWORD": "${user_config.oracle_password}",
        "ORACLE_USERNAME": "${user_config.oracle_username}",
        "ORACLE_CONNECTION_STRING": "${user_config.oracle_connection_string}"
      },
      "args": [
        "-y",
        "@toolbox-sdk/server@1.9.0",
        "--prebuilt",
        "oracledb",
        "--stdio"
      ],
      "command": "npx"
    }
  }
}